# ============ LLM 接入（本地 workbuddy2api-hub 反代网关） ============
# 网关需先在宿主 8788 端口启动；Docker 模式下 backend 的 LLM_BASE_URL
# 由 docker-compose.yml 固定为 http://host.docker.internal:8788/v1，不受此项影响
LLM_MODEL=hy4-preview-f
LLM_BASE_URL=http://127.0.0.1:8788/v1
LLM_API_KEY=

# ============ 通义千问 API Key（仅 src/agent/tools/web_search.py 联网搜索需要） ============
DASHSCOPE_API_KEY=

# ============ MongoDB 连接（本地或 Docker） ============
MONGODB_URI=mongodb://localhost:27017

# ============ ERP 后端地址 ============
# 本地开发：指向 Mock ERP（python -m src.mock_erp.main，默认端口 8081，契约见 src/mock_erp/CONTRACT.md）
# 接入真实 ERP：替换为真实服务地址即可，Agent 与 MCP 层零改动
ERP_BASE_URL=http://localhost:8081

# ============ MCP Server 地址（本地） ============
MCP_SERVER_URL=http://localhost:9000

# ============ 沙箱 Docker 镜像 ============
SANDBOX_IMAGE=python:3.11-slim
